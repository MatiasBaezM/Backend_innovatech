# Plantilla de variables de entorno para docker-compose.
# Copiar a .env y completar con valores reales:  cp .env.example .env

# Database Configuration
DB_PASSWORD=root

# API Gateway Routes (Defaults to container names)
AUTH_SERVICE_URL=http://ms-autenticacion:8081
RECURSOS_COLABORACIONES_SERVICE_URL=http://ms-recursos-colaboraciones:8082
GESTION_PROYECTOS_SERVICE_URL=http://ms-gestion-proyectos:8083
ANALITICAS_SERVICE_URL=http://ms-analiticas:8084

# CORS - Origenes permitidos (separados por coma)
# En produccion, reemplazar con el dominio real del frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173
